{
  "name": "acadia-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,CONVEX\" -c \"cyan,magenta\" \"bun run dev:vite\" \"bun run dev:convex\"",
    "dev:vite": " portless acadia-one vite dev",
    "dev:convex": "convex dev",
    "dev:setup": "convex dev --configure --until-success",
    "build": "vite build",
    "start": "vite preview",
    "lint": "ultracite fix",
    "lint:check": "ultracite check",
    "lint:file": "ultracite fix --",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.43",
    "@base-ui/react": "^1.2.0",
    "@better-upload/client": "^3.0.14",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@headless-tree/core": "^1.6.3",
    "@ncdai/react-wheel-picker": "^1.2.0",
    "@posthog/ai": "^7.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "^0.5.1",
    "@tanstack/react-devtools": "^0.9.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.159.0",
    "@tanstack/react-router-devtools": "^1.159.1",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/zod-adapter": "^1.159.5",
    "@vercel/config": "^0.0.24",
    "ai": "^5.0.116",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "convex-helpers": "^0.1.112",
    "graphql-request": "^7.4.0",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.2",
    "neverthrow": "^8.2.0",
    "posthog-js": "^1.347.0",
    "posthog-node": "^5.24.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "react-resizable-panels": "^4.6.4",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.2.1"
