{
  "name": "acadia-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,CONVEX\" -c \"cyan,magenta\" \"bun run dev:vite\" \"bun run dev:convex\"",
    "dev:vite": "portless acadia-one vite dev",
    "dev:convex": "convex dev",
    "dev:setup": "convex dev --configure --until-success",
    "build": "vite build",
    "enrich:professors": "bun scripts/enrich-professors-from-json.ts",
    "start": "portless acadia-one vite preview",
    "lint": "ultracite fix",
    "lint:check": "ultracite check",
    "lint:file": "ultracite fix --",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@base-ui/react": "^1.3.0",
    "@better-upload/client": "^3.0.14",
    "@convex-dev/react-query": "^0.1.0",
    "@posthog/ai": "^7.12.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.4",
    "@tanstack/zod-adapter": "^1.166.9",
    "@vercel/config": "^0.0.41",
    "ai": "^6.0.138",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.34.0",
    "convex-helpers": "^0.1.114",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.6.0",
    "motion": "^12.38.0",
    "posthog-js": "^1.363.4",
    "posthog-node": "^5.28.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-resizable-panels": "^4.7.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@rolldown/plugin-babel": "^0.2.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "ultracite": "^7.3.2",
    "vite": "^8.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0"
}
