{
  "name": "acadia-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,CONVEX\" -c \"cyan,magenta\" \"pnpm run dev:vite\" \"pnpm run dev:convex\"",
    "dev:vite": "portless acadia-one vp dev",
    "dev:convex": "convex dev",
    "dev:setup": "convex dev --configure --until-success",
    "build": "vp build",
    "start": "portless acadia-one vite preview"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@base-ui/react": "^1.4.1",
    "@better-upload/client": "^3.0.14",
    "@convex-dev/react-query": "^0.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/router-plugin": "^1.167.4",
    "@tanstack/zod-adapter": "^1.166.9",
    "ai": "^6.0.138",
    "axios": "^1.13.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.34.0",
    "convex-helpers": "^0.1.114",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.6.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-resizable-panels": "^4.7.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "ultracite": "^7.3.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
