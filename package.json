{
  "name": "acadia-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "op run --env-file=.env -- portless acadia-one bunx --bun vite dev",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:snapshot": "bun run scripts/db-snapshot.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "db:studio": "bunx --bun drizzle-kit studio",
    "build": "bunx --bun vite build",
    "start": "portless acadia-one bunx --bun vite preview",
    "test": "op run --env-file=.env -- bun test",
    "check": "bunx --bun ultracite check",
    "fix": "bunx --bun ultracite fix"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.167.4",
    "@tanstack/zod-adapter": "^1.167.0",
    "ai": "^6.0.138",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.17.0",
    "neverthrow": "^8.2.0",
    "ofetch": "^1.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.7.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "ultracite": "7.8.3",
    "vite": "latest"
  },
  "engines": {
    "bun": ">=1.3.12"
  },
  "packageManager": "bun@1.3.12"
}
